<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Free Music Finder: a Noctis plugin (API 1.1) that searches a Telegram music bot through the
    user's own Telegram account and downloads tracks into a folder.
    `dotnet build -c Release` writes bin/Release/FreeMusicFinder-<version>.zip, ready for
    Settings → Plugins → "Install from file…".

    Noctis.Plugins.Abstractions is not on NuGet yet, so this builds against a checkout of the
    Noctis repo (build.ps1 clones it into ../extern/Noctis). Override with -p:NoctisRepo=<path>.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FreeMusicFinder</RootNamespace>
    <AssemblyName>FreeMusicFinder</AssemblyName>
    <Version>2.0.0</Version>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <NoctisRepo Condition="'$(NoctisRepo)' == ''">$(MSBuildThisFileDirectory)..\extern\Noctis</NoctisRepo>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(NoctisRepo)\src\Noctis.Plugins.Abstractions\Noctis.Plugins.Abstractions.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="WTelegramClient" Version="4.4.9" />
  </ItemGroup>
  <Import Project="$(NoctisRepo)\samples\PluginPackage.targets" />
</Project>
