<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Free Music Finder: a Noctis plugin (API 1.1) that searches a Telegram music bot through the
    user's own Telegram account and downloads tracks into a folder.
    `dotnet build -c Release` writes bin/Release/FreeMusicFinder-<version>.zip, ready for
    Settings → Plugins → "Install from file…".

    Noctis.Plugins.Abstractions is not on NuGet yet, so this builds against a checkout of the
    Noctis repo: the release named by "minAppVersion" in plugin.json, which build.ps1 clones
    (see ../Plugin.props for why that release). Override with -p:NoctisRepo=<path>.
  -->
  <Import Project="..\Plugin.props" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FreeMusicFinder</RootNamespace>
    <AssemblyName>FreeMusicFinder</AssemblyName>
    <!-- Written once, in plugin.json. -->
    <Version>$(PluginVersion)</Version>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(NoctisRepo)\src\Noctis.Plugins.Abstractions\Noctis.Plugins.Abstractions.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="WTelegramClient" Version="4.4.9" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="FreeMusicFinder.Tests" />
  </ItemGroup>
  <Target Name="CheckPluginJson" BeforeTargets="Build">
    <Error Condition="'$(PluginVersion)' == '' Or '$(PluginMinAppVersion)' == ''" Text="plugin.json needs a &quot;version&quot; and a &quot;minAppVersion&quot;." />
    <Error Condition="!Exists('$(NoctisRepo)\src\Noctis.Plugins.Abstractions\Noctis.Plugins.Abstractions.csproj')" Text="The Noctis source is not at $(NoctisRepo). Run build.ps1, which fetches it." />
  </Target>
  <Import Project="$(NoctisRepo)\samples\PluginPackage.targets" Condition="Exists('$(NoctisRepo)\samples\PluginPackage.targets')" />
</Project>
